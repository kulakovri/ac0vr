#version 450
/* Synthetic test data for the pipeline (S4, ACZ_VR_CLOUD_TEST): checks world lock, L/R and in-between frames
   independently of the S2/S3 shaders.
   i0.x = 1: far pattern into the direction map (rect i1): lines every 10 deg of azimuth (red, every 30 deg green) and
             elevation (cyan; the horizon white), faint 10 x 10 deg checker cells, distance 3000 m.
   i0.x = 2: near pattern into the near layers (z + i0.y = eye): world-anchored horizontal planes every 100 m of
             altitude and vertical planes every 200 m of world x, 10 m checker, nearest hit within range and before
             the scene, so disparity and depth can be checked against the scene. */
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
#define CL_STORAGE
#include "cloud_common.glsl"
layout(push_constant) uniform PC { ivec4 i0; ivec4 i1; vec4 f0; vec4 f1; } pc;

void far_pattern(ivec2 id) {
    vec2 uv = (vec2(id) + 0.5) / cl.sizes.x;
    vec3 d = cl_uv_dir(uv);
    float az = degrees(atan(d.x, -d.z)) + 180.0, el = degrees(asin(clamp(d.y, -1.0, 1.0)));
    float px = 360.0 / (4.0 * cl.sizes.x);                       /* ~degrees per texel at the horizon */
    float w = max(0.15, 1.5 * px);
    float daz = abs(mod(az + 5.0, 10.0) - 5.0) * cos(radians(el)), del = abs(mod(el + 5.0, 10.0) - 5.0);
    vec3 col = vec3(0.0); float T = 1.0;
    if (abs(el) < w * 2.0) { col = vec3(1.0); T = 0.2; }
    else if (del < w) { col = vec3(0.2, 0.9, 1.0); T = 0.35; }
    else if (daz < w && abs(el) < 80.0) {
        col = abs(mod(az + 15.0, 30.0) - 15.0) * cos(radians(el)) < w ? vec3(0.2, 1.0, 0.2) : vec3(1.0, 0.25, 0.2);
        T = 0.35;
    } else if (((int(floor(az / 10.0)) + int(floor((el + 90.0) / 10.0))) & 1) == 0) { col = vec3(0.9, 0.9, 0.95); T = 0.85; }
    imageStore(cl_dir_img, id, vec4(col * (1.0 - T), T));
    imageStore(cl_dir_depth_img, id, vec4(T > 0.99 ? CL_DEPTH_NONE : 3000.0));
}

void near_pattern(ivec3 id) {
    int eye = id.z + pc.i0.y;
    ivec2 px = id.xy * 2;
    float range = cl.cfg.z, clip = range;
    for (int k = 0; k < 4; k++) {
        ivec2 q = min(px + ivec2(k & 1, k >> 1), ivec2(cl.sizes.w, cl.sizes2.x) - 1);
        clip = min(clip, cl_scene_dist_m(q, eye));
    }
    vec3 ro = cl_eye(eye), rd = cl_world_dir(vec2(px) + 1.0);
    float th = CL_INF;
    if (abs(rd.y) > 1e-4) {                       /* horizontal planes at multiples of 100 m altitude */
        float a0 = cl_alt(ro);
        float lo = floor(a0 / 100.0) * 100.0, hi = lo + 100.0;
        float t = ((rd.y > 0.0 ? hi : lo) - a0) / rd.y;
        if (t > 4.0) th = t;
    }
    float tv = CL_INF;
    if (abs(rd.x) > 1e-4) {                       /* vertical planes at multiples of 200 m of world x */
        float x0 = cl_world(ro).x;
        float lo = floor(x0 / 200.0) * 200.0, hi = lo + 200.0;
        float t = ((rd.x > 0.0 ? hi : lo) - x0) / rd.x;
        if (t > 4.0) tv = t;
    }
    float t = min(th, tv);
    vec4 o = vec4(0.0, 0.0, 0.0, 1.0);
    if (t < clip) {
        vec3 w = cl_world(ro + rd * t);
        vec2 g = th < tv ? w.xz : w.zy;
        int ck = (int(floor(g.x / 10.0)) + int(floor(g.y / 10.0))) & 1;
        float T = ck == 0 ? 0.5 : 0.9;
        vec3 col = th < tv ? vec3(1.0, 0.85, 0.3) : vec3(0.4, 0.6, 1.0);
        o = vec4(col * (1.0 - T), T);
    }
    imageStore(cl_near_img, ivec3(id.xy, eye), o);
    imageStore(cl_near_depth_img, ivec3(id.xy, eye), vec4(clip));
}

void main() {
    ivec3 id = ivec3(gl_GlobalInvocationID);
    if (pc.i0.x == 1) {
        ivec2 p = pc.i1.xy + id.xy;
        if (p.x < pc.i1.z && p.y < pc.i1.w) far_pattern(p);
    } else if (pc.i0.x == 2) {
        if (id.x < int(cl.sizes.y) && id.y < int(cl.sizes.z)) near_pattern(id);
    }
}
