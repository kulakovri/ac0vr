#version 450
/* Default weather map (C4) until S2's weather pass takes over: periodic value-noise coverage over the 20 km tile
   (REPEAT by cloud-frame position, so the content is the same wherever the camera is). R coverage (shaped by C1
   coverage), G local base 0, B local top 1, A density 1. Regenerated by ps2_clouds.c when C1 coverage changes. */
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
#define CL_STORAGE
#include "cloud_common.glsl"
layout(push_constant) uniform PC { ivec4 size; ivec4 i1; vec4 f0; vec4 f1; } pc;

float vhash(vec2 p) { return cl_hash12(p * 1.37 + 11.0); }
float vnoise2(vec2 p, float cells) {       /* tileable over one period (p in 0..1) */
    vec2 q = p * cells, i = floor(q), f = fract(q);
    f = f * f * (3.0 - 2.0 * f);
    float a = vhash(mod(i, cells)), b = vhash(mod(i + vec2(1, 0), cells));
    float c = vhash(mod(i + vec2(0, 1), cells)), d = vhash(mod(i + vec2(1, 1), cells));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}
void main() {
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(id, pc.size.xy))) return;
    vec2 p = (vec2(id) + 0.5) / vec2(pc.size.xy);
    float n = vnoise2(p, 8.0) * 0.5 + vnoise2(p, 16.0) * 0.3 + vnoise2(p, 32.0) * 0.2;
    float cov = clamp(pc.f0.x, 0.0, 1.0);                     /* C1 coverage_unmasked (else coverage) */
    float r = smoothstep(0.95 - cov * 0.8, 1.15 - cov * 0.8, n) * smoothstep(0.0, 0.05, cov);
    imageStore(cl_weather_img, id, vec4(r, 0.0, 1.0, 1.0));
}
